{
  "name": "@sondv5/browser-mcp",
  "version": "0.2.0",
  "type": "module",
  "description": "MCP stdio server that bridges to the Browser MCP Bridge extension over a local WebSocket hub",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sondv5/browser-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/sondv5/browser-mcp/issues"
  },
  "homepage": "https://github.com/sondv5/browser-mcp#readme",
  "bin": {
    "browser-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "browser",
    "chrome",
    "automation",
    "cdp"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "start": "node dist/index.js",
    "smoke": "node test/smoke.mjs",
    "prepublishOnly": "npm run build && node scripts/copy-readme.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2"
  }
}
